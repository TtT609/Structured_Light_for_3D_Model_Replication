<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- ══════════════════════════════════════════
         Full-screen live camera preview
    ══════════════════════════════════════════ -->
    <TextureView
        android:id="@+id/textureView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ══════════════════════════════════════════
         Top bar overlay (dark translucent)
    ══════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:background="#CC0D1117"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📷  Project SL"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="15sp" />

        <!-- Connection status badge -->
        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DISCONNECTED"
            android:textColor="#EF4444"
            android:textSize="9sp"
            android:textStyle="bold"
            android:background="#33EF4444"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_marginEnd="8dp" />

        <!-- Pro Mode toggle button -->
        <Button
            android:id="@+id/btnProMode"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="⚙"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:background="#44FFFFFF"
            android:layout_marginEnd="6dp"
            style="@style/Widget.AppCompat.Button.Borderless" />

        <!-- Settings button -->
        <Button
            android:id="@+id/btnSettings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="≡"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:background="#44FFFFFF"
            style="@style/Widget.AppCompat.Button.Borderless" />

    </LinearLayout>

    <!-- ══════════════════════════════════════════
         Log message chips (bottom-left overlay)
    ══════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/logContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="100dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- ══════════════════════════════════════════
         Last-capture thumbnail (bottom-right)
    ══════════════════════════════════════════ -->
    <ImageView
        android:id="@+id/imgThumbnail"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="100dp"
        android:background="#33FFFFFF"
        android:scaleType="centerCrop"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ══════════════════════════════════════════
         UPLOADING / CAPTURING spinner overlay
    ══════════════════════════════════════════ -->
    <FrameLayout
        android:id="@+id/uploadingOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#80000000"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ProgressBar
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:indeterminateTint="#FFFFFF" />

    </FrameLayout>

    <!-- ══════════════════════════════════════════
         Shutter button (bottom-center)
    ══════════════════════════════════════════ -->
    <FrameLayout
        android:id="@+id/btnShutter"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/shutter_bg"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:layout_gravity="center"
            android:background="@drawable/shutter_inner_bg" />

    </FrameLayout>

    <!-- ══════════════════════════════════════════
         SETTINGS PANEL (slides up from bottom)
    ══════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/settingsPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#EE0D1117"
        android:padding="20dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚙  App Settings"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SERVER URL"
            android:textColor="#9CA3AF"
            android:textSize="10sp"
            android:letterSpacing="0.1"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/editServerUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="http://192.168.x.x:5000"
            android:textColorHint="#6B7280"
            android:textColor="#FFFFFF"
            android:background="#1E293B"
            android:padding="12dp"
            android:inputType="textUri"
            android:singleLine="true"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CAMERA"
            android:textColor="#9CA3AF"
            android:textSize="10sp"
            android:letterSpacing="0.1"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spinnerCamera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E293B"
            android:padding="12dp"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/btnSaveSettings"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Save &amp; Close"
            android:backgroundTint="#2563EB"
            android:textColor="#FFFFFF" />

    </LinearLayout>

    <!-- ══════════════════════════════════════════
         PRO MODE PANEL (slides up from bottom)
    ══════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/proModePanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#EE0D1117"
        android:padding="20dp"
        android:paddingBottom="108dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎛  Manual Controls"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="15sp"
            android:layout_marginBottom="14dp" />

        <!-- ISO row -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="10dp">
            <TextView android:layout_width="48dp" android:layout_height="wrap_content"
                android:text="ISO" android:textColor="#9CA3AF" android:textSize="11sp"/>
            <SeekBar android:id="@+id/seekIso" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:progressTint="#A855F7"/>
            <TextView android:id="@+id/txtIso" android:layout_width="56dp" android:layout_height="wrap_content"
                android:text="AUTO" android:textColor="#FFFFFF" android:textSize="11sp"
                android:gravity="end" android:fontFamily="monospace"/>
        </LinearLayout>

        <!-- Exposure Time row -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="10dp">
            <TextView android:layout_width="48dp" android:layout_height="wrap_content"
                android:text="TIME" android:textColor="#9CA3AF" android:textSize="11sp"/>
            <SeekBar android:id="@+id/seekExpTime" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:progressTint="#06B6D4"/>
            <TextView android:id="@+id/txtExpTime" android:layout_width="56dp" android:layout_height="wrap_content"
                android:text="AUTO" android:textColor="#FFFFFF" android:textSize="11sp"
                android:gravity="end" android:fontFamily="monospace"/>
        </LinearLayout>

        <!-- Focus row -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="10dp">
            <TextView android:layout_width="48dp" android:layout_height="wrap_content"
                android:text="FOCUS" android:textColor="#9CA3AF" android:textSize="11sp"/>
            <SeekBar android:id="@+id/seekFocus" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:progressTint="#F59E0B"/>
            <TextView android:id="@+id/txtFocus" android:layout_width="56dp" android:layout_height="wrap_content"
                android:text="AUTO" android:textColor="#FFFFFF" android:textSize="11sp"
                android:gravity="end" android:fontFamily="monospace"/>
        </LinearLayout>

        <!-- Auto focus / Manual toggle -->
        <CheckBox android:id="@+id/chkManualFocus" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Manual Focus"
            android:textColor="#FFFFFF" android:layout_marginBottom="10dp"
            android:buttonTint="#F59E0B"/>

        <!-- Auto exposure / Manual toggle -->
        <CheckBox android:id="@+id/chkManualExposure" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Manual Exposure (ISO + Shutter)"
            android:textColor="#FFFFFF" android:layout_marginBottom="4dp"
            android:buttonTint="#A855F7"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
